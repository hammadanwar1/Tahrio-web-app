# Public origin used for canonical URLs, sitemap and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://tahrio.pk

# Tahrio API (../tahrio/backend). Empty = build from the bundled seed snapshot (checkout disabled).
TAHRIO_API_URL=http://localhost:4000/api

# Shared secret for POST /api/revalidate (call after editing products in the admin).
REVALIDATE_SECRET=change-me

# Optional: hostname serving product photos if the API returns absolute image URLs.
TAHRIO_IMAGE_HOST=

# Optional: Search Console / Bing Webmaster verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
