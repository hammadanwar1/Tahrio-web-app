# Public origin used for canonical URLs, sitemap, structured data and uploaded photo URLs (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://tahrio.pk

# The API runs in the same process (server.js) at /api, so TAHRIO_API_URL is set automatically.
# Only set it to use an API hosted somewhere else.
# TAHRIO_API_URL=

# ---------- API (backend/) ----------
# Secret for signing customer login tokens (mobile app + website).
JWT_SECRET=change-me
# Key for the /api/admin endpoints. The admin panel sends it server-side; never expose it.
ADMIN_KEY=change-me
# Folder for the JSON database and uploaded photos. Use a persistent disk in production.
# Defaults to backend/data.
# DATA_DIR=/var/data

# ---------- Admin panel (/admin) ----------
# Password for signing in at /admin/login.
ADMIN_PASSWORD=
# 32+ random characters used to sign the admin session cookie, e.g. `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=

# Shared secret for POST /api/revalidate (refreshes cached store pages).
REVALIDATE_SECRET=change-me

# Optional: hostname serving product photos if the API returns absolute image URLs from another host.
TAHRIO_IMAGE_HOST=

# Optional: Search Console / Bing Webmaster verification tokens.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
